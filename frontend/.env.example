# Optional override for the backend base URL.
# With Docker Compose, the Vite proxy forwards /api to http://backend:8000.
# Without Docker, or for another backend, set an origin reachable from the browser.
# In Codespaces this may be the forwarded backend URL, not localhost.
# Do not include /api or a trailing slash. Restart Vite or rebuild after changes.
VITE_API_BASE_URL=